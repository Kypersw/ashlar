From: Kypersw <dersimizkral@gmail.com>
Date: Fri, 6 Nov 2026 21:53:20 +0200
Subject: [PATCH] Ashlar update checks off


diff --git a/src/main/java/com/destroystokyo/paper/PaperVersionFetcher.java b/src/main/java/com/destroystokyo/paper/PaperVersionFetcher.java
index ba32d58c33c65b1384baa7616da64f7a4a1f0d1d..da6d60ff26c3d3eff6e7db37eecbe4fc2d501db7 100644
--- a/src/main/java/com/destroystokyo/paper/PaperVersionFetcher.java
+++ b/src/main/java/com/destroystokyo/paper/PaperVersionFetcher.java
@@ -65,6 +65,7 @@ public class PaperVersionFetcher implements VersionFetcher {
     }
 
     public static void getUpdateStatusStartupMessage() {
+        if (true) return; // Ashlar - do not ask PaperMC servers about our builds
         int distance = DISTANCE_ERROR;
 
         final OptionalInt buildNumber = BUILD_INFO.buildNumber();
@@ -108,6 +109,7 @@ public class PaperVersionFetcher implements VersionFetcher {
     }
 
     private static Component getUpdateStatusMessage() {
+        if (true) return text("Ashlar build, update checks are off.", NamedTextColor.GRAY); // Ashlar
         int distance = DISTANCE_ERROR;
 
         final OptionalInt buildNumber = PaperVersionFetcher.BUILD_INFO.buildNumber();
